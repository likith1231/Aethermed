# Copy to deploy/oracle/oracle.env (git-ignored) and fill in.

# Your Neon Postgres connection string (same one the app uses today).
# Wrap it in single quotes: it contains "&", which would otherwise cut the line short and leave it unset.
#   DATABASE_URL='postgresql://user:pass@host/db?sslmode=require&channel_binding=require'
DATABASE_URL=

# Optional. Generated and kept on the VM if left empty.
NEXTAUTH_SECRET=

# Optional: ConfigCat SDK key for the /feature-demo page.
CONFIGCAT_SDK_KEY=

# Optional. Defaults to <public-ip>.sslip.io, so the app is served at https://aethermed.<public-ip>.sslip.io
BASE_DOMAIN=

# ArgoCD GitOps: auto (on when the VM has 11+ GB RAM), true, or false.
ARGOCD=auto
